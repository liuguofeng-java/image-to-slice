{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["vite/client"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/ui.tsbuildinfo"
  },
  "include": ["src/ui/**/*.ts", "src/ui/**/*.vue"]
}
