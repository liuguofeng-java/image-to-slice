{
  "name": "image-to-slice",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "start": "node scripts/start-local.js",
    "dev": "node scripts/start-local.js",
    "api": "node server.js",
    "local-models:setup": "node scripts/setup-local-models.js",
    "local-models:check": "node scripts/check-local-models.js",
    "sam2:check": "node scripts/check-sam2.js",
    "local-ai:check": "node scripts/check-local-ai.js",
    "build": "npm run typecheck && vite build --config vite.vue.config.mts",
    "build:ui": "vite build --config vite.vue.config.mts",
    "build:vue": "vite build --config vite.vue.config.mts",
    "typecheck": "vue-tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.tools.json --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "test:vue": "vitest run",
    "test:unit": "npm run unit && npm run test:vue",
    "test:e2e": "npm run build:ui && node tests/e2e/vue-migration.cjs",
    "preview": "node scripts/start-local.js --preview",
    "unit": "node --test tests/**/*.test.js",
    "test": "npm run typecheck && npm run test:unit && node --check server.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "sharp": "^0.34.5",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
