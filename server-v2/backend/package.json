{
  "name": "slice-studio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:server": "tsx tests/e2e-server.ts",
    "format": "prettier --write src tests *.json --ignore-path ../.prettierignore",
    "format:check": "prettier --check src tests *.json --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.0",
    "@fastify/swagger": "^9.5.0",
    "sharp": "0.35.4",
    "zod": "^4.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "prettier": "3.6.2"
  }
}
